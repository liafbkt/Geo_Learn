{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows-updater",
  "description": "Check, download and install signed updates from the local main window on Windows",
  "windows": ["main"],
  "platforms": ["windows"],
  "local": true,
  "permissions": [
    "app-update:allow-check",
    "updater:allow-download",
    "updater:allow-install"
  ]
}
